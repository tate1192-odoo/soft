<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        Extended res_config_settings form view-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.product.image</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']"
                   position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="show_image_in_report"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <!-- Label comes from the field's own string. -->
                        <label for="show_image_in_report"/>
                        <div class="text-muted">
                            An image column in quotation and sale order reports, hidden automatically when no line has an image. The order line column is toggled per user from the list header.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
